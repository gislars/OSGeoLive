# Template for local/local.env (not versioned, sourced as POSIX sh).
#   cp fossgis/local.env.example local/local.env && chmod 600 local/local.env
#
# The file is copied to /tmp/fossgis/local.env inside the chroot only for
# the build and deleted by setdown.sh. Values set here end up in the image
# only where a script writes them on purpose (e.g. the WLAN profile).
# check_clean.sh refuses every commit that contains one of these values.

# Optional WLAN profile for the venue (bin/install_wifi.sh). Leave empty
# to skip. Anyone with the ISO can read the PSK from the image.
WIFI_SSID=""
WIFI_PSK=""
# wpa-psk (default) or sae
WIFI_KEY_MGMT=""
