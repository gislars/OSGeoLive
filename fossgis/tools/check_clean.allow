# Allowed hits of the keyword search in check_clean.sh.
#   line:<ERE>  added lines matching the expression are not reported
#   path:<ERE>  keyword hits in matching paths are not reported
# Values from local.env and local *.nmconnection files are always reported.

# The search patterns themselves
path:^fossgis/tools/check_clean\.(sh|allow)$
# Empty assignments, e.g. in fossgis/local.env.example
line:^[[:space:]]*[A-Za-z0-9_]+=(""|'')?[[:space:]]*(#.*)?$
# Public live session login user/user, documented in passwords.txt
line:password:[[:space:]]*user[[:space:]]*$
# pgAdmin desktop mode without master password
line:MASTER_PASSWORD_REQUIRED[[:space:]]*=[[:space:]]*False
# QGIS connection template filled with the public demo password variable
line:password=\$PSWD$
# cloud-init of the build VM: no password at all, ssh key login only
line:^[[:space:]]*sudo: "ALL=\(ALL\) NOPASSWD:ALL"$
line:^[[:space:]]*lock_passwd: true$
# Browser log of the OpenLayers examples, public example token (fossgis2026)
path:^ol_issues\.txt$
path:^bin/install_wifi\.sh$
line:WIFI_(SSID|PSK|KEY_MGMT)
