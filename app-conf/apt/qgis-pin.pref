# Prefer QGIS from qgis.org over Ubuntu universe (still ships 3.x on resolute).
# Use release label/origin from the Release file: apt's "origin" pin is the
# download host and breaks when qgis.org redirects to object storage.
Package: qgis*
Pin: release o=QGIS project
Pin-Priority: 1001

Package: libqgis*
Pin: release o=QGIS project
Pin-Priority: 1001

Package: python3-qgis*
Pin: release o=QGIS project
Pin-Priority: 1001
